#!/usr/bin/env sh
set -eu

instructions_dir="${HOME}/.config/ai-instructions"
codex_dir="${HOME}/.codex"
output="${codex_dir}/AGENTS.md"
temporary="${output}.tmp"

{
    echo '<!-- Generated by ~/.config/ai-instructions/sync-codex-agents. Do not edit directly. -->'
    echo
    cat "${instructions_dir}/CODING_STANDARDS.md"
    echo
    cat "${instructions_dir}/DOCKER_TESTING.md"
    echo
    cat "${codex_dir}/RTK.md"
} > "${temporary}"

chmod 600 "${temporary}"
mv "${temporary}" "${output}"

echo "Updated ${output}"
